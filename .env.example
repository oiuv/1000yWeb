# 复制为 .env，填写本机配置；不要提交凭据。
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# 生产环境使用 HTTPS 反向代理，改为 production 并填写唯一公开源。
# APP_ORIGIN=https://accounts.example.com
# 只信任实际代理的 IP / 子网；无反向代理时设 false，禁止 true。
TRUST_PROXY=loopback

# MSSQL 现有账号库。使用专用的最小权限数据库账号，不使用 sa。
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_DATABASE=1000y
DB_USER=web_accounts
DB_PASSWORD=replace_me
DB_ENCRYPT=false
DB_TRUST_CERTIFICATE=true

# 受控本机旧版 SQL Server 可按上例配置。
# 远程数据库须在可信网络或加密隧道内；支持有效证书时设：
# DB_ENCRYPT=true
# DB_TRUST_CERTIFICATE=false

# 管理员为数据库 account1000y.id，逗号分隔；默认 1。
ADMIN_IDS=1
# 相对项目根目录，不能放在 public/。
SQLITE_PATH=database/recharge.db

# 炎黄 Paid 同机数据。只接受绝对路径，不新增监听端口。
# 填写 PAID_DB_PATH 后可查询付费状态、禁用账号；禁用需要数据库写入权限。
# 另填写 Python 与充值脚本后启用自动充值；两项必须一起填写。
# 未启用自动充值时禁止核准含炎黄月卡/年卡的订单，其他登记正常使用。
# PAID_PYTHON=C:/Python314/python.exe
# PAID_RECHARGE_SCRIPT=D:/GameServices/paid/recharge.py
# PAID_DB_PATH=D:/GameServices/paid/data/1000yPaid.db
# DB 路径必须与正在运行的 Paid 一致；不能位于 public/ 或使用网络共享盘。

# 每日英雄榜（只读；两项路径同时填写后启用，使用现有 GBK 文件）。
# LEADERBOARD_DATA_DIR=D:/GameServer/DB/Userdata
# LEADERBOARD_POWER_LEVEL_FILE=D:/GameServer/TGS/Init/PowerLevel.sdb
# 最近可查看的备份期数，1-366；默认 30，不修改或删除原备份。
# LEADERBOARD_HISTORY=30
# 管理员、测试角色须明确排除；逗号分隔，支持角色名或完整主键“角色名:地区”。
# LEADERBOARD_EXCLUDE_CHARACTERS=管理员示例,测试角色:测试区
# 原始备份含账号、密码等私密字段；路径和文件必须在 public/ 之外。
